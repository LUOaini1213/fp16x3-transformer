# Exact cloud scripts/log text are evidence artifacts: preserve original bytes
# and hashes, including Windows CRLF and tool-generated end-of-line whitespace.
results/next/**/cloud_script.py -text whitespace=-blank-at-eol,cr-at-eol linguist-generated=true
results/next/**/*.log -text whitespace=-blank-at-eol,cr-at-eol linguist-generated=true
results/next/**/*.json -text linguist-generated=true
results/next/clean_release_summary.md text eol=lf
results/next/usability_summary.md text eol=lf
results/next/**/run.py.snapshot text eol=lf linguist-generated=true
results/next/**/user_optimized.py.snapshot text eol=lf linguist-generated=true
results/next/improvements*summary.md text eol=lf
